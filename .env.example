# Bearer key per API. These are the real secrets: store them in Passport's vault,
# and set them as Vercel environment variables. Never commit real values.
# Generate a fresh set:  npm run keys > .env.local
API_KEY_MARKETS=
API_KEY_WALLET=
API_KEY_PROMOTIONS=
API_KEY_PLAYER_LIMITS=
API_KEY_BETS=
API_KEY_GEO_COMPLIANCE=
API_KEY_ADMIN=

# Optional on Vercel: shared state across serverless instances (Upstash Redis / Vercel KV integration).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Headless Postman setup (npm run postman:push)
POSTMAN_API_KEY=
POSTMAN_WORKSPACE_ID=
