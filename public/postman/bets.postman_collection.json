  "info": {
    "_postman_id": "57266eca-759c-4888-9258-40f95cb3fcf7",
    "name": "Ridgeline · Bets API",
    "description": "Bet placement. **v2 (2026-07): `stake` (decimal dollars) was removed and replaced by `stake_minor` (integer cents).** Requests containing `stake` are rejected. Bets re-checks eligibility and location at placement as a safety net; it does not replace checking before an offer.\n\n**Owner:** Team Bet Platform\n**Auth:** Bearer `{{bets_key}}`. In the Passport environment this is `{{vault:RIDGELINE_BETS_KEY}}`, so the Passport Secure Access Proxy injects the real key. No one holds the raw key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Place a bet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bets/v1/bets",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "bets",
            "v1",
            "bets"
          ]
        },
        "description": "Place a bet",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"player_id\": \"P-1001\",\n  \"selections\": [\n    {\n      \"market_id\": \"MKT-ML-001\",\n      \"outcome_id\": \"OUT-HAWKS\"\n    }\n  ],\n  \"stake_minor\": 1000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "pm.test('responds in under 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
              "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('matches the documented response schema', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"bet_id\",\"status\",\"stake_minor\",\"potential_payout_minor\",\"rewards_earned_minor\"],\"properties\":{\"bet_id\":{\"type\":\"string\"},\"player_id\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"enum\":[\"accepted\"]},\"product\":{\"type\":\"string\",\"enum\":[\"sportsbook\",\"casino\"]},\"stake_minor\":{\"type\":\"integer\"},\"potential_payout_minor\":{\"type\":\"integer\"},\"boost_id\":{\"type\":[\"string\",\"null\"]},\"rewards_earned_minor\":{\"type\":\"integer\"},\"placed_at\":{\"type\":\"string\",\"format\":\"date-time\"}}}));"
            ]
          }
        }
      ],
