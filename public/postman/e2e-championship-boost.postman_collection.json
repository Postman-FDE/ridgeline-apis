    {
      "name": "8. END STATE: no protected player holds a claim",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/promotions/v1/boosts/claims?boost_id={{boost_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "promotions",
            "v1",
            "boosts",
            "claims"
          ],
          "query": [
            {
              "key": "boost_id",
              "value": "{{boost_id}}",
              "description": "Filter by boost."
            }
          ]
        },
        "description": "List claims for a boost",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{promotions_key}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ids = pm.response.json().claims.map(c => c.player_id);",
              "pm.test('END STATE: no claim for self-excluded P-1003', () => pm.expect(ids).to.not.include('P-1003'));",
              "pm.test('END STATE: no claim for cool-off P-1005', () => pm.expect(ids).to.not.include('P-1005'));"
            ]
          }
        }
      ],
