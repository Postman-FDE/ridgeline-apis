{
  "info": {
    "_postman_id": "f4fe37cd-5c9c-43f8-9321-52e3475ca68f",
    "name": "Ridgeline · Player Limits API",
    "description": "Responsible-gaming eligibility: self-exclusion, cool-off and daily wager limits. **The single source of truth for player protection. Never reimplement this logic in a caller.** Self-excluded and cool-off players must not receive promotional offers (`may_receive_promotions: false`).\n\n**Owner:** Team Responsible Gaming\n**Auth:** Bearer `{{player_limits_key}}`. In the Passport environment this is `{{vault:RIDGELINE_PLAYER_LIMITS_KEY}}`, so the Passport Secure Access Proxy injects the real key. No one holds the raw key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Check whether a player may wager receive promotions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/player-limits/v1/eligibility/check",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "player-limits",
            "v1",
            "eligibility",
            "check"
          ]
        },
        "description": "Check whether a player may wager / receive promotions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"player_id\": \"P-1003\",\n  \"product\": \"sportsbook\",\n  \"amount_minor\": 1000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "pm.test('responds in under 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
              "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('matches the documented response schema', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"player_id\",\"eligible\",\"reasons\",\"may_receive_promotions\"],\"properties\":{\"player_id\":{\"type\":\"string\"},\"product\":{\"type\":\"string\",\"enum\":[\"sportsbook\",\"casino\"]},\"eligible\":{\"type\":\"boolean\"},\"reasons\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"enum\":[\"SELF_EXCLUDED\",\"COOL_OFF\",\"DAILY_WAGER_LIMIT\"]}},\"may_receive_promotions\":{\"type\":\"boolean\"},\"remaining_daily_wager_minor\":{\"type\":\"integer\"},\"checked_at\":{\"type\":\"string\",\"format\":\"date-time\"}}}));"
            ]
          }
        }
      ],
