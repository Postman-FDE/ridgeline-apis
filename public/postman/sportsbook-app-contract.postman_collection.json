    {
      "name": "3. player-limits: fields the app gates offers on",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/player-limits/v1/eligibility/check",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "player-limits",
            "v1",
            "eligibility",
            "check"
          ]
        },
        "description": "Check whether a player may wager / receive promotions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"player_id\": \"P-1003\",\n  \"product\": \"sportsbook\",\n  \"amount_minor\": 1000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{player_limits_key}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('eligibility response matches contract', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"player_id\",\"eligible\",\"reasons\",\"may_receive_promotions\"],\"properties\":{\"player_id\":{\"type\":\"string\"},\"product\":{\"type\":\"string\",\"enum\":[\"sportsbook\",\"casino\"]},\"eligible\":{\"type\":\"boolean\"},\"reasons\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"enum\":[\"SELF_EXCLUDED\",\"COOL_OFF\",\"DAILY_WAGER_LIMIT\"]}},\"may_receive_promotions\":{\"type\":\"boolean\"},\"remaining_daily_wager_minor\":{\"type\":\"integer\"},\"checked_at\":{\"type\":\"string\",\"format\":\"date-time\"}}}));",
              "pm.test('may_receive_promotions present for self-excluded', () => pm.expect(pm.response.json().may_receive_promotions).to.be.false);"
            ]
          }
        }
      ],
