      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('legacy `stake` is rejected, not silently accepted', () => pm.response.to.have.status(400));",
              "pm.test('error names the replacement field', () => pm.expect(pm.response.json().replacement).to.eql('stake_minor'));"
            ]
          }
        }
