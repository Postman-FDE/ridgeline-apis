    "name": "Ridgeline · sportsbook-app consumer contract",
    "description": "Assertions owned by the **sportsbook-app** team (a consumer of bets and player-limits). Run in CI on every bets / player-limits change: `postman collection run <id> -e <env>`. A change that passes the producer's own tests but breaks these fails the build.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. bets: response shape the app renders",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bets/v1/bets",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "bets",
            "v1",
            "bets"
          ]
        },
        "description": "Place a bet",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"player_id\": \"P-1001\",\n  \"selections\": [\n    {\n      \"market_id\": \"MKT-TOT-001\",\n      \"outcome_id\": \"OUT-OVER\"\n    }\n  ],\n  \"stake_minor\": 500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bets_key}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('bet response matches sportsbook-app contract', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"bet_id\",\"status\",\"stake_minor\",\"potential_payout_minor\",\"rewards_earned_minor\"],\"properties\":{\"bet_id\":{\"type\":\"string\"},\"player_id\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"enum\":[\"accepted\"]},\"product\":{\"type\":\"string\",\"enum\":[\"sportsbook\",\"casino\"]},\"stake_minor\":{\"type\":\"integer\"},\"potential_payout_minor\":{\"type\":\"integer\"},\"boost_id\":{\"type\":[\"string\",\"null\"]},\"rewards_earned_minor\":{\"type\":\"integer\"},\"placed_at\":{\"type\":\"string\",\"format\":\"date-time\"}}}));",
              "pm.test('stake echoed in cents', () => pm.expect(pm.response.json().stake_minor).to.eql(500));"
            ]
          }
        }
      ],
