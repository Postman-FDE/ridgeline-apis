    "name": "Ridgeline · Wallet API",
    "description": "Player balances (cash, bonus, rewards) and rewards credits. All amounts are integer minor units (cents).\n\n**Owner:** Team Payments\n**Auth:** Bearer `{{wallet_key}}`. In the Passport environment this is `{{vault:RIDGELINE_WALLET_KEY}}`, so the Passport Secure Access Proxy injects the real key. No one holds the raw key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /v1/wallet/balance · Get a player balance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/wallet/v1/wallet/balance",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "wallet",
            "v1",
            "wallet",
            "balance"
          ]
        },
        "description": "Get a player balance",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"player_id\": \"P-1001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
            ]
          }
        }
      ],
      "response": [
