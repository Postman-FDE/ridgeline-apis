{
  "openapi": "3.0.3",
  "info": {
    "title": "Ridgeline Geo Compliance API",
    "version": "1.0.0",
    "description": "Which products a player may access in their state. Casino is available in NJ, PA and MI only (sandbox data).\n\nOwner: Team Compliance. Ridgeline is a fictional company; all data is sandbox data.",
    "contact": {
      "name": "Team Compliance"
    },
    "x-owner": "Team Compliance"
  },
  "servers": [
    {
      "url": "https://{host}/geo-compliance",
      "description": "Hosted sandbox (route through Passport)",
      "variables": {
        "host": {
          "default": "your-project.vercel.app"
        }
      }
    },
    {
      "url": "http://localhost:4100/geo-compliance",
      "description": "Local (next dev)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "geo-compliance",
      "description": "Which products a player may access in their state. Casino is available in NJ, PA and MI only (sandbox data)."
    }
  ],
  "paths": {
    "/v1/location/check": {
      "post": {
        "tags": [
          "geo-compliance"
        ],
        "operationId": "geo_compliance_post_location_check",
        "summary": "Check product availability for a player's location",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "player_id": "P-1004",
                  "state": "NY",
                  "product": "casino",
                  "allowed": false,
                  "reason": "PRODUCT_NOT_AVAILABLE_IN_STATE"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer key (or an unresolved Passport reference)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "player_id",
                  "product"
                ],
                "properties": {
                  "player_id": {
                    "type": "string"
                  },
                  "product": {
                    "type": "string",
                    "enum": [
                      "sportsbook",
                      "casino"
                    ]
                  }
                }
              },
              "example": {
                "player_id": "P-1004",
                "product": "casino"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Use the Passport reference {{vault:RIDGELINE_GEO_COMPLIANCE_KEY}}. Never a raw key."
      }
    }
  }
}
