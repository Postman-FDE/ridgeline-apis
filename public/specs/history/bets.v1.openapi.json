{
  "openapi": "3.0.3",
  "info": {
    "title": "Ridgeline Bets API (v1, deprecated)",
    "version": "1.4.0",
    "description": "**DEPRECATED.** Superseded by v2 (2026-07), where `stake` (decimal dollars) was replaced by `stake_minor` (integer cents). Kept for spec history only. Requests in this shape are rejected by the live API with `400 unsupported_field`.",
    "contact": {
      "name": "Team Bet Platform"
    },
    "x-owner": "Team Bet Platform"
  },
  "servers": [
    {
      "url": "https://{host}/bets",
      "description": "Hosted sandbox (route through Passport)",
      "variables": {
        "host": {
          "default": "your-project.vercel.app"
        }
      }
    },
    {
      "url": "http://localhost:4100/bets",
      "description": "Local (next dev)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "bets",
      "description": "Bet placement. **v2 (2026-07): `stake` (decimal dollars) was removed and replaced by `stake_minor` (integer cents).** Requests containing `stake` are rejected. Bets re-checks eligibility and location at placement as a safety net; it does not replace checking before an offer. Owner: Team Bet Platform."
    }
  ],
  "paths": {
    "/v1/bets": {
      "post": {
        "tags": [
          "bets"
        ],
        "operationId": "bets_post_bets",
        "summary": "Place a bet",
        "description": "Place a bet. Send `stake_minor` in cents. To apply a boost, the player must have claimed it via promotions first.\n\n**Errors**\n\n| Status | `error` | When |\n|---|---|---|\n| 400 | `unsupported_field` | The request contains the removed v1 `stake` field. The error includes `\"replacement\": \"stake_minor\"`. |\n| 400 | `invalid_amount` | `stake_minor` is not a positive integer. |\n| 403 | `player_not_eligible` | Player-limits rejected the wager. `reasons` lists why (e.g. `SELF_EXCLUDED`). |\n| 403 | `product_not_available` | The product is not available in the player's state. |\n| 404 | `selection_not_found` | Unknown `market_id` / `outcome_id`. |\n| 409 | `boost_not_claimed` | `boost_id` given but the player has not claimed it. |\n| 401 | `unauthorized` / `unresolved_reference` | Missing or wrong key, or an unresolved Passport reference |",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "bet_id",
                    "status",
                    "stake_minor",
                    "potential_payout_minor",
                    "rewards_earned_minor"
                  ],
                  "properties": {
                    "bet_id": {
                      "type": "string",
                      "description": "Sandbox player ID, `P-1001` to `P-1005`."
                    },
                    "player_id": {
                      "type": "string",
                      "description": "Sandbox player ID, `P-1001` to `P-1005`."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "accepted"
                      ],
                      "description": "Lifecycle status."
                    },
                    "product": {
                      "type": "string",
                      "enum": [
                        "sportsbook",
                        "casino"
                      ],
                      "description": "`sportsbook` or `casino`."
                    },
                    "stake_minor": {
                      "type": "integer",
                      "description": "Stake in minor units (cents). Integer, at least 1. `1000` = $10.00. Replaces the v1 `stake` field."
                    },
                    "potential_payout_minor": {
                      "type": "integer",
                      "description": "Total return if the bet wins (stake + profit, including any boost), in cents."
                    },
                    "boost_id": {
                      "type": "string",
                      "nullable": true,
                      "description": "Boost to apply. The player must have claimed it first."
                    },
                    "rewards_earned_minor": {
                      "type": "integer",
                      "description": "Rewards credited by this bet (from the boost), in cents."
                    },
                    "placed_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the bet was accepted (ISO 8601)."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`unsupported_field`: The request contains the removed v1 `stake` field. The error includes `\"replacement\": \"stake_minor\"`. `invalid_amount`: `stake_minor` is not a positive integer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "unsupported_field": {
                    "summary": "The request contains the removed v1 stake field. The error includes \"replacement\": \"stake_minor\".",
                    "value": {
                      "error": "unsupported_field",
                      "message": "The request contains the removed v1 stake field. The error includes \"replacement\": \"stake_minor\"."
                    }
                  },
                  "invalid_amount": {
                    "summary": "stake_minor is not a positive integer.",
                    "value": {
                      "error": "invalid_amount",
                      "message": "stake_minor is not a positive integer."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer key, or an unresolved Passport reference.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "unauthorized": {
                    "summary": "Missing key or another API's key",
                    "value": {
                      "error": "unauthorized",
                      "message": "Missing or invalid bearer key for this API."
                    }
                  },
                  "unresolved_reference": {
                    "summary": "A {{vault:...}} reference skipped the proxy",
                    "value": {
                      "error": "unresolved_reference",
                      "message": "Received an unresolved Passport reference. Route this call through the Passport Secure Access Proxy."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "`player_not_eligible`: Player-limits rejected the wager. `reasons` lists why (e.g. `SELF_EXCLUDED`). `product_not_available`: The product is not available in the player's state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "player_not_eligible": {
                    "summary": "Player-limits rejected the wager. reasons lists why (e.g. SELF_EXCLUDED).",
                    "value": {
                      "error": "player_not_eligible",
                      "message": "Player-limits rejected the wager. reasons lists why (e.g. SELF_EXCLUDED)."
                    }
                  },
                  "product_not_available": {
                    "summary": "The product is not available in the player's state.",
                    "value": {
                      "error": "product_not_available",
                      "message": "The product is not available in the player's state."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "`selection_not_found`: Unknown `market_id` / `outcome_id`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "selection_not_found": {
                    "summary": "Unknown market_id / outcome_id.",
                    "value": {
                      "error": "selection_not_found",
                      "message": "Unknown market_id / outcome_id."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "`boost_not_claimed`: `boost_id` given but the player has not claimed it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "boost_not_claimed": {
                    "summary": "boost_id given but the player has not claimed it.",
                    "value": {
                      "error": "boost_not_claimed",
                      "message": "boost_id given but the player has not claimed it."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "internal",
                  "message": "Unexpected error."
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "player_id",
                  "selections",
                  "stake"
                ],
                "additionalProperties": false,
                "properties": {
                  "player_id": {
                    "type": "string",
                    "description": "Boost to apply. The player must have claimed it first."
                  },
                  "product": {
                    "type": "string",
                    "enum": [
                      "sportsbook",
                      "casino"
                    ],
                    "description": "`sportsbook` or `casino`."
                  },
                  "selections": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "market_id",
                        "outcome_id"
                      ],
                      "properties": {
                        "market_id": {
                          "type": "string",
                          "description": "Boost to apply. The player must have claimed it first."
                        },
                        "outcome_id": {
                          "type": "string",
                          "description": "Boost to apply. The player must have claimed it first."
                        }
                      }
                    },
                    "description": "One or more `{ market_id, outcome_id }`. More than one makes a parlay (odds multiply)."
                  },
                  "boost_id": {
                    "type": "string",
                    "description": "Boost to apply. The player must have claimed it first."
                  },
                  "stake": {
                    "type": "number",
                    "format": "double",
                    "description": "v1 only (removed in v2): stake in dollars as a decimal."
                  }
                }
              },
              "example": {
                "player_id": "P-1001",
                "selections": [
                  {
                    "market_id": "MKT-ML-001",
                    "outcome_id": "OUT-HAWKS"
                  }
                ],
                "stake": 10
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "bets"
        ],
        "operationId": "bets_get_bets",
        "summary": "List bets",
        "description": "List bets, optionally for one `player_id`.",
        "parameters": [
          {
            "name": "player_id",
            "in": "query",
            "required": false,
            "description": "Filter by player.",
            "schema": {
              "type": "string"
            },
            "example": "P-1001"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request: missing fields, invalid JSON or invalid values.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "missing_fields",
                  "message": "Missing required field(s): player_id.",
                  "fields": [
                    "player_id"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer key, or an unresolved Passport reference.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "unauthorized": {
                    "summary": "Missing key or another API's key",
                    "value": {
                      "error": "unauthorized",
                      "message": "Missing or invalid bearer key for this API."
                    }
                  },
                  "unresolved_reference": {
                    "summary": "A {{vault:...}} reference skipped the proxy",
                    "value": {
                      "error": "unresolved_reference",
                      "message": "Received an unresolved Passport reference. Route this call through the Passport Secure Access Proxy."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "internal",
                  "message": "Unexpected error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Use the Passport reference {{vault:RIDGELINE_BETS_KEY}}. Never a raw key."
      }
    }
  }
}
