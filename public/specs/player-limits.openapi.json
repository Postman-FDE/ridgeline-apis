{
  "openapi": "3.0.3",
  "info": {
    "title": "Ridgeline Player Limits API",
    "version": "1.0.0",
    "description": "Responsible-gaming eligibility: self-exclusion, cool-off and daily wager limits. **The single source of truth for player protection. Never reimplement this logic in a caller.** Self-excluded and cool-off players must not receive promotional offers (`may_receive_promotions: false`).\n\nOwner: Team Responsible Gaming. Ridgeline is a fictional company; all data is sandbox data.",
    "contact": {
      "name": "Team Responsible Gaming"
    },
    "x-owner": "Team Responsible Gaming"
  },
  "servers": [
    {
      "url": "https://{host}/player-limits",
      "description": "Hosted sandbox (route through Passport)",
      "variables": {
        "host": {
          "default": "your-project.vercel.app"
        }
      }
    },
    {
      "url": "http://localhost:4100/player-limits",
      "description": "Local (next dev)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "player-limits",
      "description": "Responsible-gaming eligibility: self-exclusion, cool-off and daily wager limits. **The single source of truth for player protection. Never reimplement this logic in a caller.** Self-excluded and cool-off players must not receive promotional offers (`may_receive_promotions: false`)."
    }
  ],
  "paths": {
    "/v1/eligibility/check": {
      "post": {
        "tags": [
          "player-limits"
        ],
        "operationId": "player_limits_post_eligibility_check",
        "summary": "Check whether a player may wager / receive promotions",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "player_id",
                    "eligible",
                    "reasons",
                    "may_receive_promotions"
                  ],
                  "properties": {
                    "player_id": {
                      "type": "string"
                    },
                    "product": {
                      "type": "string",
                      "enum": [
                        "sportsbook",
                        "casino"
                      ]
                    },
                    "eligible": {
                      "type": "boolean"
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "SELF_EXCLUDED",
                          "COOL_OFF",
                          "DAILY_WAGER_LIMIT"
                        ]
                      }
                    },
                    "may_receive_promotions": {
                      "type": "boolean"
                    },
                    "remaining_daily_wager_minor": {
                      "type": "integer"
                    },
                    "checked_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "example": {
                  "player_id": "P-1003",
                  "product": "sportsbook",
                  "eligible": false,
                  "reasons": [
                    "SELF_EXCLUDED"
                  ],
                  "may_receive_promotions": false,
                  "remaining_daily_wager_minor": 50000,
                  "checked_at": "2026-10-07T17:26:18.296Z"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer key (or an unresolved Passport reference)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "player_id",
                  "product"
                ],
                "properties": {
                  "player_id": {
                    "type": "string"
                  },
                  "product": {
                    "type": "string",
                    "enum": [
                      "sportsbook",
                      "casino"
                    ]
                  },
                  "amount_minor": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Optional wager amount in cents."
                  }
                }
              },
              "example": {
                "player_id": "P-1003",
                "product": "sportsbook",
                "amount_minor": 1000
              }
            }
          }
        }
      }
    },
    "/v1/limits": {
      "post": {
        "tags": [
          "player-limits"
        ],
        "operationId": "player_limits_post_limits",
        "summary": "Get a player's limits and status",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "player_id": "P-1002",
                  "status": "active",
                  "daily_wager_limit_minor": 5000,
                  "wagered_today_minor": 3000
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer key (or an unresolved Passport reference)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "player_id"
                ],
                "properties": {
                  "player_id": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "player_id": "P-1002"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Use the Passport reference {{vault:RIDGELINE_PLAYER_LIMITS_KEY}}. Never a raw key."
      }
    }
  }
}
